PORT=3000
HOST=127.0.0.1
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=chin_lcl
PGUSER=chin_lcl
PGPASSWORD=
# Generar con: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Origen exacto del frontend; separar varios con comas. Vacío deshabilita CORS.
CORS_ORIGINS=http://localhost:5173

# Prisma Postgres: usar la URL PostgreSQL del panel Connect (no prisma://).
# DATABASE_URL tiene prioridad sobre PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
# DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
# Alternativa con variables PG*: activar TLS y validar el certificado.
# PGSSLMODE=require